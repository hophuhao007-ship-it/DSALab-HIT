Stats insertionSortCount(vector<int> arr) {
    Stats s;
    int n = arr.size();
    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0) {
            s.comparisons++;
            if (arr[j] > key) {
                arr[j + 1] = arr[j];
                s.swaps++; // Tính số lần dịch chuyển tịnh tiến sang phải
                j--;
            }
            else break; // Ngắt dừng sớm khi thấy số nhỏ hơn key (bí kíp Best Case)
        }
        arr[j + 1] = key;
    }
    return s;
}

