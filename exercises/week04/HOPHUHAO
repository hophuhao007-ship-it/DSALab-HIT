// Cấu trúc dùng để lưu trữ số phép toán cho Bài 2
struct Stats {
    long long comparisons = 0; // Số lần so sánh (liếc mắt nhìn)
    long long swaps = 0;       // Số lần hoán đổi hoặc dịch chuyển (tốn sức tay)
};

