// BÀI 3: ĐO THỜI GIAN CHẠY THỰC TẾ (BEST / WORST / AVERAGE CASE)
// ============================================================

double measureBubble(vector<int> arr) {
    auto start = Clock::now();
    int n = arr.size();
    for (int i = 0; i < n - 1; i++) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; j++)
            if (arr[j] > arr[j + 1]) { swap(arr[j], arr[j + 1]); swapped = true; }
        if (!swapped) break;
    }
    return chrono::duration<double, micro>(Clock::now() - start).count();
}

double measureSelection(vector<int> arr) {
    auto start = Clock::now();
    int n = arr.size();
    for (int i = 0; i < n - 1; i++) {
        int minIdx = i;
        for (int j = i + 1; j < n; j++)
            if (arr[j] < arr[minIdx]) minIdx = j;
        if (minIdx != i) swap(arr[i], arr[minIdx]);
    }
    return chrono::duration<double, micro>(Clock::now() - start).count();
}

double measureInsertion(vector<int> arr) {
    auto start = Clock::now();
    int n = arr.size();
    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) { arr[j + 1] = arr[j]; j--; }
        arr[j + 1] = key;
    }
    return chrono::duration<double, micro>(Clock::now() - start).count();
}

void bai3() {
    const int N = 3000; // Quy mô mảng lớn để thấy rõ sự chênh lệch thời gian thực tế
    srand(42);

    // Kịch bản Best case: mảng tăng dần sẵn
    vector<int> best(N);
    for (int i = 0; i < N; i++) best[i] = i;

    // Kịch bản Worst case: mảng đảo ngược giảm dần
    vector<int> worst(N);
    for (int i = 0; i < N; i++) worst[i] = N - i;

    // Kịch bản Average case: mảng ngẫu nhiên hoàn toàn
    vector<int> avg(N);
    for (int i = 0; i < N; i++) avg[i] = rand() % 10000;

    cout << "\n============================================================\n";
    cout << "BAI 3: DO THOI GIAN CHAY (mang " << N << " phan tu, don vi: microseconds)\n";
    cout << "============================================================\n";
    cout << left << setw(20) << "Thuat toan"
        << setw(20) << "Best (Tot nhat)"
        << setw(20) << "Worst (Xau nhat)"
        << setw(20) << "Average (Ngau nhien)" << endl;
    cout << string(70, '-') << endl;

    cout << fixed << setprecision(2);
    cout << left << setw(20) << "Bubble Sort" << setw(20) << measureBubble(best) << setw(20) << measureBubble(worst) << setw(20) << measureBubble(avg) << endl;
    cout << left << setw(20) << "Selection Sort" << setw(20) << measureSelection(best) << setw(20) << measureSelection(worst) << setw(20) << measureSelection(avg) << endl;
    cout << left << setw(20) << "Insertion Sort" << setw(20) << measureInsertion(best) << setw(20) << measureInsertion(worst) << setw(20) << measureInsertion(avg) << endl;

    cout << "\n📌 KET LUAN NHANH VE THOI GIAN:\n";
    cout << "- Insertion Sort: Ve dich dau tien o cot Best Case nho triet tieu hoan toan buoc dich chuyen.\n";
    cout << "- Selection Sort: Thoi gian o cot Best hay Worst lech nhau rat it (luon giu muc O(n^2)).\n";
    cout << "- Bubble Sort: Chay rất đuoi suc o cot mang Ngau nhien (Average) và Ngược (Worst).\n";
}
