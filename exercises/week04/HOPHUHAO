// 1. BUBBLE SORT (Sắp xếp nổi bọt)
void bubbleSort(vector<int> arr) {
    int n = arr.size();
    cout << "\n--- Bubble Sort (Demo mang nho) ---\n";
    cout << "Ban dau: ";
    for (int x : arr) cout << x << " ";
    cout << endl;

    for (int i = 0; i < n - 1; i++) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; j++) {

            // 🔑 DÒNG QUAN TRỌNG: So sánh và hoán đổi cặp kề nhau
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                swapped = true;
            }
        }
        cout << "Buoc " << i + 1 << ": ";
        for (int x : arr) cout << x << " ";
        cout << endl;

        // Thoát sớm nếu cả vòng quét không có bất kỳ lệnh swap nào
        if (!swapped) break;
    }
}
//Tốt nhất (Best Case)
// Ví dụ cụ thể: {10, 20, 30, 40, 50}Tại sao tốt nhất: Máy tính quét qua cặp kề nhau đúng 1 vòng duy nhất để kiểm tra. Vì không phát hiện bất kỳ cặp nào sai thứ tự, 
// lệnh swap không chạy $\rightarrow$ cờ hiệu swapped giữ nguyên là false $\rightarrow$ lệnh break kích hoạt và tắt máy nghỉ sớm luôn.

//Xấu nhất (Worst Case)
//Ví dụ cụ thể : {50, 40, 30, 20, 10}
//Tại sao xấu nhất : Các số lớn nhất nằm sai vị trí trầm trọng ở đầu dãy.Thuật toán phải "lết" từng bước một để đẩy số lớn về cuối hàng.Số lần so sánh và số lần swap tráo đổi ô nhớ đều đạt mức kịch khung.

// 2. SELECTION SORT (Sắp xếp chọn)
void selectionSort(vector<int> arr) {
    int n = arr.size();
    cout << "\n--- Selection Sort (Demo mang nho) ---\n";
    cout << "Ban dau: ";
    for (int x : arr) cout << x << " ";
    cout << endl;

    for (int i = 0; i < n - 1; i++) {
        int minIdx = i;
        for (int j = i + 1; j < n; j++) {

            // 🔑 DÒNG QUAN TRỌNG: Quét để ghi nhớ vị trí kẻ nhỏ nhất
            if (arr[j] < arr[minIdx]) minIdx = j;
        }
        // Tìm xong kẻ nhỏ nhất trong đoạn mới thực hiện swap duy nhất 1 lần về đầu
        if (minIdx != i) swap(arr[i], arr[minIdx]);

        cout << "Buoc " << i + 1 << ": ";
        for (int x : arr) cout << x << " ";
        cout << endl;
    }
}
//Tốt nhất (Best Case)
//Ví dụ cụ thể : {11, 22, 33, 44, 55}
//Tại sao tốt nhất : Ở kịch bản này, điểm tốt duy nhất là bạn không tốn sức hoán đổi
//swap) dữ liệu vì phần tử đầu đoạn luôn chính là phần tử nhỏ nhất(minIdx == i).Tuy nhiên, thuật toán này rất "bảo thủ",
// nó vẫn bắt máy tính chạy đủ các vòng lặp để quét mắt kiểm tra cạn kiệt không thiếu một số nào.

//Xấu nhất(Worst Case)
// Ví dụ cụ thể: {55, 44, 33, 22, 11}
// Tại sao xấu nhất: Cứ mỗi bước liếc nhìn sang phần tử tiếp theo, máy tính lại phát hiện ra một số nhỏ hơn số trước đó,
// buộc biến vị trí minIdx phải liên tục cập nhật lại giá trị mới, đồng thời số lần thực hiện hàm swap đạt mức tối đa (n-1 lần).

// 3. INSERTION SORT (Sắp xếp chèn)
void insertionSort(vector<int> arr) {
    int n = arr.size();
    cout << "\n--- Insertion Sort (Demo mang nho) ---\n";
    cout << "Ban dau: ";
    for (int x : arr) cout << x << " ";
    cout << endl;

    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;

        // 🔑 DÒNG QUAN TRỌNG: Dịch chuyển các phần tử lớn hơn sang phải để dọn đường
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key; // Chèn phần tử vào khoảng trống vừa tạo

        cout << "Buoc " << i << ": ";
        for (int x : arr) cout << x << " ";
        cout << endl;
    }
}
//Tốt nhất (Best Case)
// Ví dụ cụ thể: {12, 22, 32, 42, 52}
// Tại sao tốt nhất: Giống như khi bạn chơi bài Tây, bạn bốc một quân bài mới lên, liếc mắt nhìn sang bên trái thấy nó đã lớn hơn quân bài trước đó rồi.
// Điều kiện vòng lặp while (arr[j] > key) bị sai ngay lập tức, 
// vòng lặp không chạy quân bài được cắm luôn tại chỗ mà không tốn bất kỳ một bước dịch chuyển mảng nào.

// Xấu nhất (Worst Case)
// Ví dụ cụ thể: {52, 42, 32, 22, 12}
// Tại sao xấu nhất: Cứ mỗi lần bạn bốc một quân bài mới ở phía sau, 
// bạn lại phải lội ngược dòng so sánh về tận đầu hàng (vị trí số 0) và bắt buộc tất cả các quân bài đứng phía trước phải dịch chuyển tịnh tiến sang bên phải để dọn đường trống, 
// cực kỳ tốn công sức dời dữ liệu.


// BÀI 2: ĐẾM SỐ PHÉP SO SÁNH VÀ HOÁN VỊ (MẢNG 100 PHẦN TỬ)


Stats bubbleSortCount(vector<int> arr) {
    Stats s;
    int n = arr.size();
    for (int i = 0; i < n - 1; i++) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; j++) {
            s.comparisons++;
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                s.swaps++;
                swapped = true;
            }
        }
        if (!swapped) break;
    }
    return s;
}
